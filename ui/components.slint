// Controls styled after media/DESIGN.md. Every user-visible string goes through @tr()
// so a Russian translation can be added later without touching the layout.

import { Theme } from "theme.slint";

// Editing shortcuts by physical key: Slint matches Ctrl+V by the typed character, which
// fails on Cyrillic layouts ("м"). Rust maps an event to "copy", "cut", "paste",
// "select-all" or "".
export global EditKeys {
    pure callback action(/* text */ string, /* ctrl */ bool, /* shift */ bool) -> string;
}

export component Icon inherits Image {
    in property <brush> tint: Theme.text-soft;
    width: 16px;
    height: 16px;
    colorize: tint;
}

// Fills the corner of its parent outside the circle the corner is rounded to. The software
// renderer paints a gradient to the square box and ignores border-radius on it, so a
// gradient is rounded by covering the four corners with the color behind it.
component CornerMask inherits Rectangle {
    in property <length> radius;
    in property <color> mask-color;
    // Which corner of the parent this sits in; the parent places it.
    in property <bool> right;
    in property <bool> bottom;

    width: root.radius;
    height: root.radius;
    clip: true;

    // A ring whose inner edge is the circle of the corner, centered in the corner square
    // (or on its far corner), thick enough to reach the square's outer corner.
    Rectangle {
        x: (root.right ? 0px : root.radius) - 2 * root.radius;
        y: (root.bottom ? 0px : root.radius) - 2 * root.radius;
        width: 4 * root.radius;
        height: 4 * root.radius;
        border-radius: 2 * root.radius;
        border-width: root.radius;
        border-color: root.mask-color;
    }
}

// A two-stop gradient with rounded corners. The gradient itself is the renderer's own, so
// its steps fall in different places for each color channel and stay as fine as 8-bit
// color allows; stacked bands of solid color, tried first, step all three channels at once
// and show as stripes. The corners are masked with `backdrop`, which has to be the color
// behind the element: the page color for a card, close enough for a control on a card's
// right half, where the card has all but faded to it. Draw the edge as a separate
// Rectangle over this.
export component GradientFill inherits Rectangle {
    // Colors at the start edge (top, or left when horizontal) and at the end edge.
    in property <color> from;
    in property <color> to;
    in property <length> radius: Theme.radius-md;
    in property <bool> horizontal: false;
    in property <color> backdrop: Theme.canvas;

    background: @linear-gradient(root.horizontal ? 90deg : 180deg, root.from 0%, root.to 100%);

    CornerMask {
        x: 0px;
        y: 0px;
        radius: root.radius;
        mask-color: root.backdrop;
    }

    CornerMask {
        x: parent.width - self.width;
        y: 0px;
        radius: root.radius;
        mask-color: root.backdrop;
        right: true;
    }

    CornerMask {
        x: 0px;
        y: parent.height - self.height;
        radius: root.radius;
        mask-color: root.backdrop;
        bottom: true;
    }

    CornerMask {
        x: parent.width - self.width;
        y: parent.height - self.height;
        radius: root.radius;
        mask-color: root.backdrop;
        right: true;
        bottom: true;
    }
}

// neutral: the raised-to-canvas gradient. ghost: outline only. ghost-muted: flat, for toolbars.
// contrast: the Ink button, a black well on a dark surface.
export enum ButtonKind { neutral, contrast, ghost, ghost-muted, danger }

export component Button {
    in property <string> text;
    in property <image> icon;
    in property <ButtonKind> kind: ButtonKind.neutral;
    in property <bool> small: false;
    in property <bool> enabled: true;
    callback clicked();

    property <bool> keyboard-focus: false;
    property <bool> gradient: root.kind == ButtonKind.neutral || root.kind == ButtonKind.danger;
    property <color> content-color: root.kind == ButtonKind.contrast ? Theme.text-strong
        : root.kind == ButtonKind.danger ? Theme.danger
        : root.kind == ButtonKind.ghost-muted ? (ta.has-hover || ta.pressed ? Theme.text : Theme.text-muted)
        : Theme.text;

    min-height: small ? 24px : 28px;
    max-height: self.min-height;
    min-width: layout.min-width;
    preferred-width: layout.preferred-width;
    horizontal-stretch: 0;
    opacity: enabled ? 1 : 0.5;

    accessible-role: button;
    accessible-label: text;
    accessible-enabled: enabled;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }

    fs := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        focus-gained(reason) => {
            root.keyboard-focus = reason == FocusReason.tab-navigation;
        }
        focus-lost(reason) => {
            root.keyboard-focus = false;
        }
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    // neutral and danger take the Hugging Face button gradient: raised at the top fading
    // to canvas, lighter on hover. The other kinds get a plain hover wash.
    if root.gradient: GradientFill {
        from: root.enabled && ta.has-hover ? Theme.raised-hover : Theme.raised;
        to: Theme.canvas;
    }

    if root.kind == ButtonKind.contrast: Rectangle {
        border-radius: Theme.radius-md;
        background: #000000;
    }

    Rectangle {
        border-radius: Theme.radius-md;
        background: !root.enabled ? transparent
            : ta.pressed ? Theme.pressed
            : ta.has-hover && !root.gradient ? Theme.hover
            : transparent;
        border-width: root.kind == ButtonKind.ghost-muted ? 0 : 1px;
        border-color: root.kind == ButtonKind.ghost ? Theme.line-strong : Theme.line;
    }

    if fs.has-focus && root.keyboard-focus: Rectangle {
        x: -3px;
        y: -3px;
        width: root.width + 6px;
        height: root.height + 6px;
        border-radius: Theme.radius-md + 3px;
        border-width: 2px;
        border-color: Theme.link;
    }

    layout := HorizontalLayout {
        padding-left: root.small ? 10px : 12px;
        padding-right: self.padding-left;
        spacing: 6px;
        alignment: center;

        if root.icon.width > 0: VerticalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                tint: root.content-color;
            }
        }

        if root.text != "": Text {
            text: root.text;
            vertical-alignment: center;
            font-size: Theme.text-body;
            font-weight: Theme.weight-semibold;
            color: root.content-color;
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

export component Switch {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    in property <string> label;
    callback toggled(bool);

    property <bool> keyboard-focus: false;

    width: 32px;
    height: 18px;
    opacity: enabled ? 1 : 0.5;

    accessible-role: switch;
    accessible-label: label;
    accessible-checkable: true;
    accessible-checked: checked;
    accessible-action-default => {
        root.flip();
    }

    function flip() {
        if (root.enabled) {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }

    fs := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        focus-gained(reason) => {
            root.keyboard-focus = reason == FocusReason.tab-navigation;
        }
        focus-lost(reason) => {
            root.keyboard-focus = false;
        }
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.flip();
                return accept;
            }
            return reject;
        }
    }

    Rectangle {
        border-radius: Theme.radius-pill;
        background: root.checked ? Theme.accent : Theme.raised;
        animate background { duration: 90ms; easing: ease-out; }
        border-width: 1px;
        border-color: root.checked ? Theme.accent : Theme.line-strong;

        Rectangle {
            y: 3px;
            width: ta.has-hover && root.enabled ? 14px : 12px;
            height: 12px;
            x: root.checked ? parent.width - self.width - 3px : 3px;
            animate x, width { duration: 90ms; easing: ease-out; }
            border-radius: self.height / 2;
            background: root.checked ? Theme.text-strong : Theme.text-muted;
        }
    }

    if fs.has-focus && root.keyboard-focus: Rectangle {
        x: -3px;
        y: -3px;
        width: root.width + 6px;
        height: root.height + 6px;
        border-radius: (root.height + 6px) / 2;
        border-width: 2px;
        border-color: Theme.link;
    }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.flip();
        }
    }
}

export component TextField {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> password: false;
    in property <bool> mono: false;
    in property <bool> enabled: true;
    // Optional glyph at the start, e.g. a magnifier in a search field.
    in property <image> icon;
    callback edited(string);
    callback accepted(string);

    property <length> text-left: root.icon.width > 0 ? 34px : 12px;

    height: 32px;
    min-width: 120px;
    preferred-width: 260px;
    opacity: enabled ? 1 : 0.5;

    forward-focus: input;
    accessible-role: text-input;
    accessible-placeholder-text: placeholder;

    Rectangle {
        border-radius: Theme.radius-md;
        background: Theme.canvas;
        border-width: 1px;
        border-color: input.has-focus ? Theme.link : Theme.line-strong;
    }

    if root.icon.width > 0: Icon {
        x: 11px;
        source: root.icon;
        tint: Theme.text-faint;
    }

    Rectangle {
        x: root.text-left;
        width: parent.width - root.text-left - 12px;
        clip: true;

        if root.text == "" && input.preedit-text == "": Text {
            width: 100%;
            height: 100%;
            text: root.placeholder;
            color: Theme.text-faint;
            vertical-alignment: center;
            overflow: elide;
            font-size: Theme.text-body;
            font-family: root.mono ? Theme.mono-family : Theme.font-family;
        }

        input := TextInput {
            width: 100%;
            height: 100%;
            text <=> root.text;
            enabled: root.enabled;
            single-line: true;
            vertical-alignment: center;
            color: Theme.text;
            font-size: Theme.text-body;
            font-weight: Theme.weight-regular;
            font-family: root.mono ? Theme.mono-family : Theme.font-family;
            input-type: root.password ? InputType.password : InputType.text;
            selection-background-color: Theme.selection;
            selection-foreground-color: Theme.text-strong;
            key-pressed(event) => {
                let action = EditKeys.action(event.text, event.modifiers.control, event.modifiers.shift);
                if (action == "paste") {
                    self.paste();
                } else if (action == "copy") {
                    self.copy();
                } else if (action == "cut") {
                    self.cut();
                } else if (action == "select-all") {
                    self.select-all();
                } else {
                    return reject;
                }
                return accept;
            }
            edited => {
                root.edited(self.text);
            }
            accepted => {
                root.accepted(self.text);
            }
        }
    }
}

// A dropdown in the neutral-button style; the list opens in a popup below it.
export component Select {
    in property <[string]> model;
    in-out property <int> current-index;
    in property <bool> enabled: true;
    callback selected(int);

    property <length> row-height: 30px;

    height: 32px;
    min-width: 160px;
    preferred-width: 260px;
    opacity: enabled ? 1 : 0.5;

    accessible-role: combobox;
    accessible-value: current-index >= 0 && current-index < model.length ? model[current-index] : "";

    GradientFill {
        from: root.enabled && ta.has-hover ? Theme.raised-hover : Theme.raised;
        to: Theme.canvas;
    }

    Rectangle {
        border-radius: Theme.radius-md;
        background: ta.pressed ? Theme.pressed : transparent;
        border-width: 1px;
        border-color: popup.is-open ? Theme.link : Theme.line;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 6px;

        Text {
            horizontal-stretch: 1;
            text: root.current-index >= 0 && root.current-index < root.model.length ? root.model[root.current-index] : "";
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
            font-size: Theme.text-body;
        }

        VerticalLayout {
            alignment: center;
            Icon {
                source: @image-url("icons/chevron-down.svg");
                tint: Theme.text-muted;
            }
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => {
            popup.show();
        }
    }

    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: root.width;
        height: min(root.model.length * root.row-height + 12px, 8 * root.row-height + 12px);
        close-policy: PopupClosePolicy.close-on-click-outside;

        Rectangle {
            border-radius: Theme.radius-md;
            background: Theme.raised;
            border-width: 1px;
            border-color: Theme.line-strong;
            drop-shadow-color: #00000080;
            drop-shadow-offset-y: 1px;
            drop-shadow-blur: 3px;
            clip: true;

            list := Flickable {
                x: 6px;
                y: 6px;
                width: parent.width - 12px;
                height: parent.height - 12px;
                mouse-drag-pan-enabled: false;
                content-height: root.model.length * root.row-height;
                init => {
                    // Scroll so that the current entry is visible when the list opens.
                    self.content-y = -max(0px, min(root.current-index * root.row-height - 2 * root.row-height, self.content-height - self.height));
                }

                for label[i] in root.model: Rectangle {
                    y: i * root.row-height;
                    height: root.row-height;
                    width: list.width;
                    border-radius: Theme.radius-sm;
                    background: item-ta.has-hover ? Theme.hover : transparent;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;

                        Text {
                            horizontal-stretch: 1;
                            text: label;
                            color: i == root.current-index ? Theme.text : Theme.text-soft;
                            font-weight: i == root.current-index ? Theme.weight-semibold : Theme.weight-regular;
                            vertical-alignment: center;
                            overflow: elide;
                            font-size: Theme.text-body;
                        }

                        if i == root.current-index: VerticalLayout {
                            alignment: center;
                            Icon {
                                source: @image-url("icons/check.svg");
                                tint: Theme.link;
                            }
                        }
                    }

                    item-ta := TouchArea {
                        clicked => {
                            root.current-index = i;
                            root.selected(i);
                            popup.close();
                        }
                    }
                }
            }

            // Thin scrollbar thumb, shown only when the list overflows.
            if list.content-height > list.height: Rectangle {
                x: parent.width - 7px;
                width: 3px;
                height: max(24px, list.height * list.height / list.content-height);
                y: 6px + (-list.content-y) / (list.content-height - list.height) * (list.height - self.height);
                border-radius: 2px;
                background: Theme.scrollbar;
            }
        }
    }
}

// A vertical list that creates only the rows in view. The Slint compiler virtualizes a
// `for` placed directly inside a component named ListView with these properties, so
// this works without the std widgets. Rows need a fixed height and no `y`.
export component ListView {
    out property <length> visible-width <=> flickable.width;
    out property <length> visible-height <=> flickable.height;
    in-out property <length> content-width <=> flickable.content-width;
    in-out property <length> content-height <=> flickable.content-height;
    in-out property <length> content-y <=> flickable.content-y;

    accessible-role: list;

    flickable := Flickable {
        width: parent.width;
        height: parent.height;
        mouse-drag-pan-enabled: false;
        @children
    }

    // Thin scrollbar thumb, shown only when the list overflows.
    if flickable.content-height > flickable.height: Rectangle {
        x: parent.width - 4px;
        width: 3px;
        height: max(24px, flickable.height * flickable.height / flickable.content-height);
        y: (-flickable.content-y) / (flickable.content-height - flickable.height) * (flickable.height - self.height);
        border-radius: 2px;
        background: Theme.scrollbar;
    }
}

export component Segmented {
    in property <[string]> model;
    in-out property <int> current-index;
    in property <length> item-padding: 12px;
    // Segments share the full width equally instead of hugging their labels.
    in property <bool> stretch: false;
    callback selected(int);

    height: 32px;
    accessible-role: tab-list;

    Rectangle {
        border-radius: Theme.radius-md;
        background: Theme.canvas;
        border-width: 1px;
        border-color: Theme.line;
    }

    HorizontalLayout {
        padding: 3px;
        spacing: 2px;

        for label[i] in root.model: Rectangle {
            horizontal-stretch: root.stretch ? 1 : 0;
            preferred-width: root.stretch ? 1px : seg-layout.preferred-width;
            border-radius: Theme.radius-sm;
            background: i == root.current-index ? Theme.raised : seg-ta.has-hover ? Theme.hover : transparent;
            animate background { duration: 120ms; }
            accessible-role: tab;
            accessible-label: label;

            seg-layout := HorizontalLayout {
                padding-left: root.item-padding;
                padding-right: root.item-padding;

                Text {
                    text: label;
                    color: i == root.current-index ? Theme.text : Theme.text-muted;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    font-size: Theme.text-body;
                    font-weight: i == root.current-index ? Theme.weight-semibold : Theme.weight-regular;
                }
            }

            seg-ta := TouchArea {
                clicked => {
                    root.current-index = i;
                    root.selected(i);
                }
            }
        }
    }
}

export component Tag inherits Rectangle {
    in property <string> text;
    in property <color> text-color: Theme.text-soft;

    height: 20px;
    border-radius: Theme.radius-sm;
    background: Theme.raised;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;

        Text {
            text: root.text;
            color: root.text-color;
            font-size: Theme.text-caption;
            font-weight: Theme.weight-semibold;
            vertical-alignment: center;
        }
    }
}

export component Keycap inherits Rectangle {
    in property <string> text;

    height: 20px;
    border-radius: Theme.radius-sm;
    background: Theme.raised;
    border-width: 1px;
    border-color: Theme.line-strong;

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;

        Text {
            text: root.text;
            color: Theme.text;
            font-size: Theme.text-caption;
            font-weight: Theme.weight-semibold;
            vertical-alignment: center;
        }
    }
}

// Settings card: Midnight Panel fading to Deep Night from left to right, a hairline edge,
// no shadow.
export component Card inherits Rectangle {
    GradientFill {
        from: Theme.panel;
        to: Theme.canvas;
        horizontal: true;
    }

    Rectangle {
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Theme.line;
    }

    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 2px;
        padding-bottom: 2px;
        @children
    }
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.line;
}

export component SectionTitle inherits Text {
    color: Theme.text;
    font-size: Theme.text-title;
    font-weight: Theme.weight-semibold;
}

// Title and description on the left, the control on the right.
export component SettingsRow {
    in property <string> title;
    in property <string> description;
    in property <color> description-color: Theme.text-muted;

    HorizontalLayout {
        padding-top: 14px;
        padding-bottom: 14px;
        spacing: 24px;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            Text {
                text: root.title;
                color: Theme.text;
                font-size: Theme.text-body;
                font-weight: Theme.weight-semibold;
            }

            if root.description != "": Text {
                text: root.description;
                color: root.description-color;
                font-size: Theme.text-small;
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            @children
        }
    }
}

export component NavItem {
    in property <string> text;
    in property <image> icon;
    in property <bool> active;
    callback clicked();

    height: 32px;
    accessible-role: tab;
    accessible-label: text;

    Rectangle {
        border-radius: Theme.radius-sm;
        background: root.active ? Theme.raised : ta.has-hover ? Theme.hover : transparent;
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;

        VerticalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                tint: root.active ? Theme.link : ta.has-hover ? Theme.text : Theme.text-muted;
            }
        }

        Text {
            text: root.text;
            color: root.active ? Theme.link : ta.has-hover ? Theme.text : Theme.text-muted;
            vertical-alignment: center;
            font-size: Theme.text-body;
            font-weight: root.active ? Theme.weight-semibold : Theme.weight-regular;
        }
    }

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}
